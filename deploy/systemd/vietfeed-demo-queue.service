[Unit]
Description=VietFeed demo queue worker (redis)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dolakhoa
Group=dolakhoa
WorkingDirectory=/home/dolakhoa/vietfeed-demo
# WAIT_MONGO_PORT is read only by wait-for-stores.sh: the published Mongo port (27018 on the owner PC). Edit if different.
Environment=WAIT_MONGO_PORT=27018
ExecStartPre=/home/dolakhoa/vietfeed-demo/deploy/systemd/wait-for-stores.sh
ExecStart=/usr/bin/php8.4 artisan queue:work redis --queue=default --sleep=3 --tries=3 --timeout=60 --max-time=3600
# --max-time makes the worker exit cleanly every hour (picks up new code); Restart=always starts it again.
# Hardening compatible with writing storage/ and bootstrap/cache in the worktree under /home.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=70
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
