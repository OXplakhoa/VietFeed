# VietFeed public demo (https://vietfeed.app) - production-style env template. NO SECRETS here.
# Install:  cp deploy/env.demo.example ~/vietfeed-demo/.env && chmod 600 ~/vietfeed-demo/.env
# (Do not name it .env.demo: Laravel would load that file when APP_ENV=demo, which demo-reset.sh sets for one command.)
# Then replace every CHANGE_ME / empty value in the copy, and run `php artisan key:generate`.
# The real .env is never committed and never pasted into chat.

APP_NAME=VietFeed
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vietfeed.app
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=file

# Visible "Demo - Stripe test mode, data may be reset" banner (config app.demo_mode). Off by default in the app.
DEMO_MODE=true

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Behind Cloudflare -> cloudflared -> Caddy -> php-fpm every hop reaches PHP from loopback.
# Read by config/trustedproxy.php (cache-safe). Caddy binds 127.0.0.1 only and reaches PHP over a unix socket.
# Never use "*" here.
TRUSTED_PROXIES=127.0.0.1

# Sessions on Redis connection "default" (DB REDIS_DB). Cookie is HTTPS-only (.app is HSTS-preloaded).
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# null = host-only cookie (not shared with subdomains).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis: DEDICATED demo instance on 127.0.0.1:6380 (deploy/docker-compose.demo.yml, noeviction) ---
# Dev keeps its own Redis on 6379 (DB 0/1/2). The DB numbers below are kept distinct anyway as a second guard.
# default (sessions, queue, locks) = REDIS_DB, cache = REDIS_CACHE_DB, nosql (streams, trending, quotas) = REDIS_NOSQL_DB.
# Leave REDIS_URL unset: a /db suffix in it would override these numbers.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Any new strong password; docker-compose.demo.yml reads this same value to start the demo Redis.
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6380
REDIS_DB=5
REDIS_CACHE_DB=6
REDIS_NOSQL_DB=7

# --- MongoDB (shared container with dev, separate database) ---
# MONGO_ROOT_*/NEO4J_* must EQUAL the values the running dev containers were created with (compose defaults or your dev .env).
# They are not new credentials; use the dev stack's real values here.
MONGO_HOST=127.0.0.1
# Must match the host port published by docker compose on this machine (27017 default, 27018 on the owner PC).
MONGO_PORT=27018
MONGO_ROOT_USER=CHANGE_ME
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_DB=vietfeed_demo

# --- Cassandra (shared container with dev, separate keyspace; CQL has no auth, loopback only) ---
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_CLUSTER_NAME=vietfeed
CASSANDRA_KEYSPACE=vietfeed_demo

# --- Neo4j (Community edition = ONE database, shared with dev; demo data is UUID-scoped nodes in it) ---
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=CHANGE_ME
NEO4J_PASSWORD=CHANGE_ME

# Mail is only logged (storage/logs); no real mail leaves the demo.
MAIL_MAILER=log
# With MAIL_MAILER=log nobody receives verification mail: public sign-ups stay unverified (registration is left open on
# purpose). The banner tells visitors to use the demo reader account.
MAIL_FROM_ADDRESS="no-reply@vietfeed.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe: TEST keys only (pk_test_/sk_test_). Never put live keys here. ---
# Webhook endpoint in the Stripe test dashboard: https://vietfeed.app/stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Google OAuth (optional; leave empty to disable) ---
# Authorized redirect URI in Google Cloud Console must be exactly this (route auth.google.callback):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://vietfeed.app/auth/google/callback

EXCHANGERATE_API_KEY=

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- StoryLens AI brief: "gemini" (set GEMINI_API_KEY) or "none" (no generation). ---
# Keep none by default: "gemini" lets /admin story retries spend API quota (cost/abuse risk). Enable only deliberately.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_BRIEF_REQUIRE_REVIEW=true

VITE_APP_NAME="${APP_NAME}"
