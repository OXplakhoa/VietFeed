APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=redis

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Gate 9.5 slice 5: no SQL database. MongoDB (MONGO_* below) is the only database connection and
# DB_CONNECTION/DB_* are no longer read. Legacy SQL data: see docs/database/nosql-local.md (tag pre-sql-removal).

# T1 (Gate 5): sessions live on Redis. Cutover = mass logout by design (old DB
# sessions are unreadable once the driver flips); remember-me recaller survives
# via cookie + users.remember_token.
SESSION_DRIVER=redis
# Explicit: null would ride the cache connection (DB 1). default = DB 0.
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# T2 (Gate 5): queues run on Redis (default conn, DB 0).
# Gate 9.5 slice 5: failed jobs are MongoDB documents (collection failed_jobs, provider
# database-uuids on the mongodb connection) — durable, inspectable, unaffected by redis flushes.
# Job batches (unused) are MongoDB-backed too. Password reset tokens live in Redis (cache store
# `redis`, TTL 60 min); AUTH_PASSWORD_RESET_STORE overrides the store.
QUEUE_CONNECTION=redis

# T2 (Gate 5): cache runs on Redis (cache conn, DB 1). TickerService pre-warm
# on the actual target cache store before traffic depends on it (fetch once).
# Stale .bak fallback is served when upstream fails; there is no stampede lock.
# RateLimiter state
# resets on flip — cut over at low traffic (local dev: no action).
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Empty = fall through to the compose dev-default. Do NOT write the literal
# "null" here: compose reads it as a real password (breaking redis AUTH),
# while Laravel would parse it as null. Set a real value only for a local secret.
REDIS_PASSWORD=
REDIS_PORT=6379
# Own DB index: cache uses DB 1, sessions DB 0 (never share an index).
REDIS_NOSQL_DB=2

# Local NoSQL dev stack (docker-compose.yml, Gate 1). Throwaway local-only
# creds live in the shell/compose defaults; never commit real values here.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_DB=vietfeed

CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_CLUSTER_NAME=vietfeed
CASSANDRA_KEYSPACE=vietfeed
# Local CQL has no auth (loopback-bound dev default); no username/password keys.

NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=
NEO4J_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

EXCHANGERATE_API_KEY=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# First-party API lifetimes, in seconds (safe example defaults; maximum one year).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# StoryLens AI brief. Use fake for an offline demo and none to disable generation.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_THINKING_LEVEL=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
AI_TIMEOUT_SECONDS=10
AI_CONNECT_TIMEOUT_SECONDS=3
AI_MAX_EVIDENCE=8
AI_DISPATCH_SPACING_SECONDS=6
AI_RETRY_DELAY_SECONDS=30
AI_SYNC_RETRY_DELAY_SECONDS=3
AI_BRIEF_REQUIRE_REVIEW=true
