APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Empty = fall through to the compose dev-default. Do NOT write the literal
# "null" here: compose reads it as a real password (breaking redis AUTH),
# while Laravel would parse it as null. Set a real value only for a local secret.
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_NOSQL_DB=1

# Local NoSQL dev stack (docker-compose.yml, Gate 1). Throwaway local-only
# creds live in the shell/compose defaults; never commit real values here.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_DB=vietfeed

CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_CLUSTER_NAME=vietfeed
CASSANDRA_KEYSPACE=vietfeed
# Local CQL has no auth (loopback-bound dev default); no username/password keys.

NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=
NEO4J_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

EXCHANGERATE_API_KEY=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=vnd
CASHIER_CURRENCY_LOCALE=vi_VN
